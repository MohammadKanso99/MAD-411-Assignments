<?xml version="1.0" encoding="utf-8"?>



<navigation xmlns:android="http://schemas.android.com/apk/res/android"


    xmlns:app="http://schemas.android.com/apk/res-auto"


    xmlns:tools="http://schemas.android.com/tools"


    app:startDestination="@id/mainFragment">





    <!-- Main Fragment (Task List) -->


    <fragment


        android:id="@+id/mainFragment"


        android:name="com.example.assignment6.MainFragment"


        android:label="Expense List"


        tools:layout="@layout/fragment_main">





        <!-- Action: Navigate to TaskDetailsFragment -->


        <action


            android:id="@+id/action_mainFragment_to_DetailsFragment"


            app:destination="@id/DetailsFragment" />





        <!-- Action: Navigate to AddTaskFragment -->


        <action


            android:id="@+id/action_mainFragment_to_addExpenseFragment"


            app:destination="@id/addExpenseFragment" />


    </fragment>





    <!-- Task Details Fragment -->


    <fragment


        android:id="@+id/DetailsFragment"


        android:name="com.example.assignment6.DetailsFragment"


        android:label="Expense Details"


        tools:layout="@layout/fragment_details" />





    <!-- Add Task Fragment -->


    <fragment


        android:id="@+id/addExpenseFragment"


        android:name="com.example.assignment6.AddExpenseFragment"


        android:label="Add Expense"


        tools:layout="@layout/fragment_add_expense" />


</navigation>